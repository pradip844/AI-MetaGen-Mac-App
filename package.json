{
  "name": "ai-metagen-pro",
  "version": "1.0.0",
  "description": "AI MetaGen Pro Desktop App for macOS",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac --universal"
  },
  "author": "AI MetaGen Pro",
  "devDependencies": {
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.aimetagenpro.desktop",
    "productName": "AI MetaGen Pro",
    "mac": {
      "category": "public.app-category.photography",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ]
  },
  "dependencies": {
    "express": "^5.3.0"
  }
}
